"{\n  \"agreementDate\": \"07/20/2018\",\n  \"placeOfSigning\": \"Not specified\",\n  \"supporting_documents\": [\n    \"Lead Based Paint Disclosure Form\",\n    \"EPA Pamphlet (Lead in Your Home Brochure)\"\n  ],\n  \"parties\": [\n    {\n      \"name\": \"Gunian Real Estate (Lessor)\",\n      \"address\": \"Not specified (c/o Real Property Management Pittsburgh, 134 S Highland Ave, Pittsburgh, PA 15206)\",\n      \"phone\": \"(412) 600-4824\",\n      \"email\": \"Not specified\",\n      \"CIN\": \"Not specified\",\n      \"PAN\": \"Not specified\",\n      \"GST\": \"Not specified\",\n      \"obligations\": [\n        {\n          \"clauseNumber\": \"1.4\",\n          \"description\": \"Receive rent payments\",\n          \"clauseText\": \"The rent shall be $1,400.00 per month and shall be due on or before the 1st day of each month without demand, payable to the following: Online at RPMpittsburgh.com. Or, mail to: Real Property Management Pittsburgh, 134 S Highland Ave, Pittsburgh, PA 15206.\"\n        },\n        {\n          \"clauseNumber\": \"1.5\",\n          \"description\": \"Hold and return security deposit as per conditions\",\n          \"clauseText\": \"Lessee agrees to pay Lessor (Gunian Real Estate) a refundable security deposit of $1,400.00. Gunian Real Estate will hold the security deposit. ... If the condition is the same as when originally occupied at Lessor’s discretion, the refundable deposit will be returned in a manner consistent with the law, after final inspection, which will occur after property is vacated and keys have been returned to Lessor.\"\n        },\n        {\n          \"clauseNumber\": \"2.3\",\n          \"description\": \"Right of entry for inspection, repairs, or emergencies\",\n          \"clauseText\": \"Upon 24 hours notice by telephone, text, email, hand-delivery or posting to Lessee, Lessor or Lessor’s designee has the right of entry to the premises for, repairs, appraisals, inspections, exhibit property to potential tenants, or for any other reason. Lessor has immediate right of entry in cases of emergency, or to protect or preserve the premises.\"\n        },\n        {\n          \"clauseNumber\": \"3.8\",\n          \"description\": \"Recover attorney fees and court costs if Lessee violates lease\",\n          \"clauseText\": \"Lessee shall be responsible for any and all court costs and attorneys fees if Lessor employs an attorney due to Lessee’s violation of any term or conditions of this Lease.\"\n        }\n      ]\n    },\n    {\n      \"name\": \"Abhishek Sawarkar, Shaleen Kumar Gupta, Saheb Singh Gandh (Lessee)\",\n      \"address\": \"Not specified\",\n      \"phone\": \"Not specified\",\n      \"email\": \"Not specified\",\n      \"CIN\": \"Not specified\",\n      \"PAN\": \"Not specified\",\n      \"GST\": \"Not specified\",\n      \"obligations\": [\n        {\n          \"clauseNumber\": \"1.4\",\n          \"description\": \"Pay rent on time\",\n          \"clauseText\": \"The rent shall be $1,400.00 per month and shall be due on or before the 1st day of each month without demand, payable to the following: Online at RPMpittsburgh.com. Or, mail to: Real Property Management Pittsburgh, 134 S Highland Ave, Pittsburgh, PA 15206.\"\n        },\n        {\n          \"clauseNumber\": \"1.5\",\n          \"description\": \"Pay and maintain security deposit conditions\",\n          \"clauseText\": \"Lessee agrees to pay Lessor (Gunian Real Estate) a refundable security deposit of $1,400.00. ... Lessee shall at its own expense and at all times maintain the premises in a clean and sanitary manner in accordance with the law and with this Lease Agreement, including keeping any equipment, appliances, furniture and furnishings in as good condition as received, normal wear and tear excepted.\"\n        },\n        {\n          \"clauseNumber\": \"1.6\",\n          \"description\": \"Pay late fees if rent is late\",\n          \"clauseText\": \"In the event payment is received by the Lessor after the 1st day of each month, (including weekends and holidays) then there shall be a late fee assessed in accordance with the law, of $50.00 Flat Fee which is due immediately. If rent is not paid by the 5th of the month an additional $5.00 per day late fee will be added to initial fee.\"\n        },\n        {\n          \"clauseNumber\": \"1.7\",\n          \"description\": \"Pay NSF fees for dishonored checks\",\n          \"clauseText\": \"Lessee agrees to pay Lessor a NSF (Non-sufficient funds) fee of $30.00 for any dishonored check. Lessee agrees that any and all NSF fees shall be deemed as Additional Rent due.\"\n        },\n        {\n          \"clauseNumber\": \"1.8\",\n          \"description\": \"Pay service fees for legal or cure notices\",\n          \"clauseText\": \"Lessee agrees that should Lessor (or any agent of Lessor) deliver and serve upon the Lessee any notice to cure, legal notice, or any notice that Lessor determines is necessary to serve to Lessee because of any perceived violations of the law or this Lease, then Lessee agrees to pay a service fee of $75 for each such notice.\"\n        },\n        {\n          \"clauseNumber\": \"1.10\",\n          \"description\": \"Stay for entire lease term or pay penalties\",\n          \"clauseText\": \"Lessee must stay entire length of lease or all deposits will be forfeited. If Lessee vacates unit prior to the end of this lease, Lessee will be responsible for rents and other fees per this agreement through the end of the lease period, or until the unit is re-rented to a qualified lessee, whichever is sooner.\"\n        },\n        {\n          \"clauseNumber\": \"2.1\",\n          \"description\": \"No smoking in premises\",\n          \"clauseText\": \"No smoking. Lessee, guests or invitees, nor any other person shall be allowed to smoke in the premises. ... If smoking does occur on the premises: 1) lessee is responsible for all damage caused by the smoking including but not limited to, stains, burns, odors, and removal of debris. 2) Lessee is in breach of this agreement.\"\n        },\n        {\n          \"clauseNumber\": \"2.2\",\n          \"description\": \"No pets without approval and additional deposit\",\n          \"clauseText\": \"Pets are allowed on or in the premises ONLY at Lessor’s approval. If permission is given, Lessee must pay an additional security deposit of $350.00 per cat and/or $450.00 per domestic dog.\"\n        },\n        {\n          \"clauseNumber\": \"3.11\",\n          \"description\": \"Obtain renter's insurance\",\n          \"clauseText\": \"LESSEE IS RESPONSIBLE FOR OBTAINING RENTER'S INSURANCE TO PROTECT LESSEE'S PERSONAL BELONGINGS. THIS IS A REQUIRED TERM OF THIS LEASE AGREEMENT.\"\n        }\n      ]\n    }\n  ],\n  \"penalty_clauses\": [\n    {\n      \"clauseNumber\": \"1.6\",\n      \"description\": \"Late payment of rent\",\n      \"penaltyDetails\": \"$50 flat fee if rent is late after the 1st of the month; additional $5 per day after the 5th.\"\n    },\n    {\n      \"clauseNumber\": \"1.7\",\n      \"description\": \"NSF (Non-sufficient funds) fee\",\n      \"penaltyDetails\": \"$30 fee for any dishonored check.\"\n    },\n    {\n      \"clauseNumber\": \"1.8\",\n      \"description\": \"Service fee for legal/cure notices\",\n      \"penaltyDetails\": \"$75 for each notice served due to violations.\"\n    },\n    {\n      \"clauseNumber\": \"1.10\",\n      \"description\": \"Early termination of lease\",\n      \"penaltyDetails\": \"Forfeiture of all deposits if Lessee vacates early; responsible for rent and fees until end of lease or until re-rented.\"\n    },\n    {\n      \"clauseNumber\": \"2.1\",\n      \"description\": \"Smoking in premises\",\n      \"penaltyDetails\": \"Lessee responsible for all damages; breach of agreement; may require vacating premises.\"\n    },\n    {\n      \"clauseNumber\": \"2.3\",\n      \"description\": \"Denial of entry to Lessor\",\n      \"penaltyDetails\": \"$50 fee if Lessor is denied access after proper notice.\"\n    }\n  ],\n  \"arbitration_clause\": {\n    \"amicable_settlement\": \"Not specified\",\n    \"arbitration\": \"Not specified in the provided text. Lease refers to Pennsylvania law and court jurisdiction for disputes.\",\n    \"arbitral_tribunal\": \"Not specified\",\n    \"final_and_binding\": \"Not specified\",\n    \"seat_and_venue\": \"Not specified\",\n    \"language\": \"Not specified\",\n    \"costs\": \"Not specified\"\n  }\n}"