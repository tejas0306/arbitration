"{\n  \"agreementDate\": \"22nd day of June, 2025\",\n  \"party_1\": {\n    \"name\": \"Tata Group Company\",\n    \"address\": \"Nariman point, Mumbai\"\n  },\n  \"party_2\": {\n    \"name\": \"Adani Group Company\",\n    \"address\": \"Ahmedabad, Gujarat\"\n  },\n  \"arbitration_clause\": {\n    \"amicable_settlement\": \"In the event of any dispute or difference arising out of or in connection with this Agreement, the Parties shall first attempt to resolve the dispute amicably through mutual discussions within 30 days of the written notice of dispute.\",\n    \"arbitration\": \"If the dispute is not resolved amicably within the above period, such dispute shall be finally resolved by arbitration in accordance with the Arbitration and Conciliation Act, 1996, as amended from time to time.\",\n    \"arbitral_tribunal\": \"The arbitral tribunal shall consist of three arbitrators: one appointed by each Party, and the third (presiding) arbitrator appointed by the two appointed arbitrators.\",\n    \"seat_and_venue\": \"The seat and venue of arbitration shall be Mumbai, India.\",\n    \"language\": \"The language of the arbitration proceedings shall be English.\",\n    \"final_and_binding \": \"The decision of the arbitral tribunal shall be final and binding on the Parties.\",\n    \"costs \": \"The costs of arbitration shall be borne equally by the Parties unless otherwise determined by the arbitral tribunal.\"\n  }\n}"