// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLAIMANT
  RESPONDENT
  ARBITRATOR
  ADMIN
}

enum ArbitratorStatus {
  ACTIVE
  INACTIVE
  PENDING
}

// Adding new enum for tracking arbitrator proposal status
enum ArbitratorProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

// Adding new enum for tracking who proposed the arbitrator
enum ProposedBy {
  CLAIMANT
  RESPONDENT
  SYSTEM
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  name         String
  role         UserRole @default(CLAIMANT)
  organization String?
  phone        String?  // Phone number
  
  // Fields specific to arbitrators
  expertise         String?  // Subject Matter Expertise
  qualifications    String?  // Professional Qualification
  experience        Int?     // Years of Experience
  bio               String?  // Professional bio/Profile Summary
  pastExperience    String?  // Past Arbitration Experience
  languages         String?  // Languages known (comma-separated)
  location          String?  // Location/Address
  hourlyRate        Float?   // Fee per case/session
  availabilityInfo  String?  // General availability info
  status            String?  // active, inactive, pending
  
  // Document uploads for arbitrators
  documentUrls      Json?    // URLs of uploaded proofs, CVs, certificates
  
  // Calendar/Availability
  blockoutDates     Json?    // Dates when arbitrator is not available
  hearingPreference String?  // In-person or Virtual preference
  
  // Disclosure form fields
  conflictOfInterest Json?   // Conflict declarations for cases
  
  // Auto-tracked fields
  rating            Float?   // Average rating from feedback
  scoreMetrics      Json?    // System-calculated arbitrator score metrics
  
  // Common fields
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Add relation to arbitrations
  arbitrations Arbitration[]
  
  // Add relation to feedback
  receivedFeedback ArbitratorFeedback[]
  
  // Add relation to arbitrator proposals
  proposedAsArbitrator ArbitratorProposal[] @relation("ProposedArbitrator")
  arbitratorProposals ArbitratorProposal[] @relation("Proposer")
  
  // Add relation to case assignments
  caseAssignments CaseAssignment[]
}

model ArbitratorFeedback {
  id            String   @id @default(uuid())
  arbitratorId  String
  arbitrator    User     @relation(fields: [arbitratorId], references: [id])
  caseId        String?
  rating        Float    // 1-5 rating
  feedback      String?  // Textual feedback
  submittedBy   String?  // User ID of who submitted feedback
  submitterRole String?  // CLAIMANT or RESPONDENT
  createdAt     DateTime @default(now())
}

model Arbitration {
  id                  String   @id @default(uuid())
  caseNumber          String   @unique
  type                String
  name                String
  pincode            String
  address1           String
  address2           String?
  city               String
  district           String
  state              String
  country            String
  email              String
  phoneCountryCode   String
  phone              String
  gst                String?
  pan                String?
  cin                String?
  additionalClaimants Json[]
  respondents        Json[]
  arbitrationAgreement Json
  disputeDetails     Json
  documents         Json?
  managerDetails    Json?
  prayers          Json?
  payment          Json?
  arguments        Json?
  formData         Json?    // Store the complete form structure for drafts
  status            String   @default("pending")
  // New fields for editable petitions
  isDraft           Boolean  @default(true)
  version           Int      @default(1)
  lastEditedAt      DateTime @default(now())
  // Add relation to user
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  // Add relation to assigned arbitrator
  arbitratorId      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Fields for arbitrator selection process
  arbitratorSelectionStatus String? @default("not_started") // not_started, in_progress, completed
  currentProposerRole String? // Tracks whose turn it is to propose next (CLAIMANT/RESPONDENT)
  
  // Add relation to arbitrator proposals
  arbitratorProposals ArbitratorProposal[]
  
  // Add relation to case assignments
  caseAssignments CaseAssignment[]
}

// New model for tracking arbitrator proposals
model ArbitratorProposal {
  id String @id @default(uuid())
  
  // Relations
  caseId String
  case Arbitration @relation(fields: [caseId], references: [id])
  arbitratorId String
  arbitrator User @relation("ProposedArbitrator", fields: [arbitratorId], references: [id])
  
  // Who proposed this arbitrator
  proposedById String
  proposedBy User @relation("Proposer", fields: [proposedById], references: [id])
  proposerRole ProposedBy
  
  // Status of this proposal
  status ArbitratorProposalStatus @default(PENDING)
  sequence Int // To track the order of proposals
  
  // Response details
  respondedAt DateTime?
  responseNotes String?
  
  // Arbitrator acceptance details (if proposal is accepted by both parties)
  arbitratorAccepted Boolean? // null=not decided, true=accepted, false=rejected
  arbitratorResponseAt DateTime?
  arbitratorNotes String?
  
  // Disclosure document (when arbitrator accepts)
  disclosureDocuments Json?
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Model for tracking case assignments to arbitrators
model CaseAssignment {
  id String @id @default(uuid())
  
  // Relations
  caseId String
  case Arbitration @relation(fields: [caseId], references: [id])
  arbitratorId String
  arbitrator User @relation(fields: [arbitratorId], references: [id])
  
  // Assignment details
  status String // PENDING, ACCEPTED, REJECTED
  respondedAt DateTime?
  notes String?
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
