// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLAIMANT
  RESPONDENT
  ARBITRATOR
  ADMIN
}

enum ArbitratorStatus {
  ACTIVE
  INACTIVE
  PENDING
}

// Adding new enum for tracking arbitrator proposal status
enum ArbitratorProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

// Adding new enum for tracking who proposed the arbitrator
enum ProposedBy {
  CLAIMANT
  RESPONDENT
  SYSTEM
  ADMIN
}

// New enums for respondent functionality
enum NotificationStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum NotificationType {
  CASE_NOTICE
  ARBITRATOR_PROPOSAL
  HEARING_SCHEDULE
  AWARD_ISSUED
  REMINDER
  SYSTEM_MESSAGE
}

enum ResponseStatus {
  PENDING
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

enum CasePhase {
  NOTICE_SENT
  RESPONSE_PENDING
  RESPONSE_SUBMITTED
  ARBITRATOR_SELECTION
  EVIDENCE_PHASE
  HEARING_PHASE
  AWARD_PHASE
  COMPLETED
  APPEALED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  name         String
  role         UserRole @default(CLAIMANT)
  organization String?
  phone        String?  // Phone number
  
  // Fields specific to arbitrators
  expertise         String?  // Subject Matter Expertise
  qualifications    String?  // Professional Qualification
  experience        Int?     // Years of Experience
  bio               String?  // Professional bio/Profile Summary
  pastExperience    String?  // Past Arbitration Experience
  languages         String?  // Languages known (comma-separated)
  location          String?  // Location/Address
  hourlyRate        Float?   // Fee per case/session
  availabilityInfo  String?  // General availability info
  
  // Status fields
  status            ArbitratorStatus @default(PENDING)
  isActive          Boolean @default(true)
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  arbitrations        Arbitration[]
  arbitratorProposals ArbitratorProposal[]
  caseAssignments     CaseAssignment[]
  respondentCases     RespondentCase[]
  notificationsSent   CaseNotification[] @relation("NotificationSender")
  notificationsReceived CaseNotification[] @relation("NotificationRecipient")
  caseResponses       CaseResponse[]
  respondentResponses RespondentResponse[] @relation("RespondentResponses")
  
  // General notification relations
  generalNotificationsSent Notification[] @relation("NotificationSender")
  generalNotificationsReceived Notification[] @relation("NotificationRecipient")
  
  // Hearing relations
  hearingsAsArbitrator Hearing[] @relation("HearingArbitrator")
  
  // Feedback and ratings
  arbitratorFeedback ArbitratorFeedback[]
}

model ArbitratorFeedback {
  id String @id @default(uuid())
  
  // Relations
  arbitratorId String
  arbitrator User @relation(fields: [arbitratorId], references: [id])
  caseId String
  case Arbitration @relation(fields: [caseId], references: [id])
  
  // Feedback details
  rating Int // 1-5 scale
  comment String?
  category String // e.g., "Professionalism", "Communication", "Decision Quality"
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Arbitration {
  id String @id @default(uuid())
  
  // Basic case information
  caseNumber String? @unique
  name String
  type String
  status String @default("DRAFT")
  priority String @default("NORMAL")
  
  // Case details
  disputeDetails Json?
  arbitrationAgreement Json?
  documents Json?
  
  // Parties involved
  claimant Json?
  additionalClaimants Json?
  managerDetails Json?
  respondents Json?
  
  // Dispute information
  natureOfDispute Json?
  disputeDescriptions Json?
  prayers Json?
  arguments Json?
  
  // Financial information
  payment Json?
  
  // Evidence and documents
  documentsEvidence Json?
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  userId String
  user User @relation(fields: [userId], references: [id])
  arbitratorProposals ArbitratorProposal[]
  caseAssignments CaseAssignment[]
  respondentCases RespondentCase[]
  notifications CaseNotification[]
  caseResponses CaseResponse[]
  respondentResponses RespondentResponse[]
  arbitratorFeedback ArbitratorFeedback[]
  
  // New relations
  generalNotifications Notification[]
  hearings Hearing[]
}

model ArbitratorProposal {
  id String @id @default(uuid())
  
  // Relations
  caseId String
  case Arbitration @relation(fields: [caseId], references: [id])
  arbitratorId String
  arbitrator User @relation(fields: [arbitratorId], references: [id])
  
  // Proposal details
  status ArbitratorProposalStatus @default(PENDING)
  proposedBy ProposedBy
  proposedAt DateTime @default(now())
  
  // Response details
  respondedAt DateTime?
  response String? // ACCEPTED, REJECTED, etc.
  responseNotes String?
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CaseAssignment {
  id String @id @default(uuid())
  
  // Relations
  caseId String
  case Arbitration @relation(fields: [caseId], references: [id])
  arbitratorId String
  arbitrator User @relation(fields: [arbitratorId], references: [id])
  
  // Assignment details
  assignedAt DateTime @default(now())
  assignedBy String // User ID who made the assignment
  
  // Status
  isActive Boolean @default(true)
  deactivatedAt DateTime?
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RespondentCase {
  id String @id @default(uuid())
  
  // Relations
  caseId String
  case Arbitration @relation(fields: [caseId], references: [id])
  respondentId String
  respondent User @relation(fields: [respondentId], references: [id])
  
  // Respondent details for this case
  respondentType String // Individual, Company, etc.
  respondentName String
  respondentEmail String
  respondentPhone String?
  respondentAddress Json? // Complete address details
  
  // Case-specific respondent status
  notificationStatus NotificationStatus @default(SENT)
  responseStatus ResponseStatus @default(PENDING)
  currentPhase CasePhase @default(NOTICE_SENT)
  
  // Important dates
  noticeServedAt DateTime @default(now())
  responseDeadline DateTime?
  respondedAt DateTime?
  
  // Tracking
  noticeAttempts Int @default(1)
  lastNoticeAt DateTime @default(now())
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Unique constraint to prevent duplicate respondent-case relationships
  @@unique([caseId, respondentId])
}

// Model for case notifications (emails, SMS, etc.)
model CaseNotification {
  id String @id @default(uuid())
  
  // Relations
  caseId String
  case Arbitration @relation(fields: [caseId], references: [id])
  senderId String
  sender User @relation("NotificationSender", fields: [senderId], references: [id])
  recipientId String
  recipient User @relation("NotificationRecipient", fields: [recipientId], references: [id])
  
  // Notification details
  type NotificationType
  subject String
  message String
  status NotificationStatus @default(SENT)
  
  // Delivery tracking
  sentAt DateTime @default(now())
  deliveredAt DateTime?
  readAt DateTime?
  
  // Email/SMS details
  emailId String? // External email service ID
  smsId String? // External SMS service ID
  
  // Metadata
  metadata Json? // Additional data like attachments, etc.
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Model for respondent responses to arbitration cases
model CaseResponse {
  id String @id @default(uuid())
  
  // Relations
  caseId String
  case Arbitration @relation(fields: [caseId], references: [id])
  respondentId String
  respondent User @relation(fields: [respondentId], references: [id])
  
  // Response content
  responseOverview String // Summary of response
  admitsClaimInFull Boolean @default(false)
  admitsClaimInPart Boolean @default(false)
  deniesClaimInFull Boolean @default(false)
  
  // Detailed responses
  disputePointResponses Json[] // Response to each dispute point
  counterClaims Json[] // Any counter-claims
  
  // Documents and evidence
  documents Json[] // Uploaded documents
  evidence Json[] // Evidence submissions
  witnessStatements Json[] // Witness statements
  
  // Legal arguments
  legalArguments String?
  lawsReliedUpon Json[] // Legal precedents cited
  
  // Additional details
  additionalNotes String?
  requestedReliefs Json[] // What respondent is asking for
  
  // Status tracking
  status ResponseStatus @default(PENDING)
  submittedAt DateTime?
  reviewedAt DateTime?
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Model for tracking respondent registration and onboarding
model RespondentRegistration {
  id String @id @default(uuid())
  
  // Basic details
  email String @unique
  name String
  phone String?
  
  // Registration source
  caseId String? // If registering due to a specific case
  invitationToken String? // Unique token for case invitation
  
  // Registration status
  isRegistered Boolean @default(false)
  registeredAt DateTime?
  
  // Verification
  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)
  verificationToken String?
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Model for respondent responses to arbitration cases (new structure)
model RespondentResponse {
  id String @id @default(uuid())
  
  // Relations
  arbitrationId String
  arbitration Arbitration @relation(fields: [arbitrationId], references: [id])
  submittedBy String
  user User @relation("RespondentResponses", fields: [submittedBy], references: [id])
  
  // Response data
  responseData Json // Complete response data including field-by-field responses
  
  // Status
  status ResponseStatus @default(SUBMITTED)
  
  // Timestamps
  submittedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Model for general notifications
model Notification {
  id String @id @default(uuid())
  
  // Basic notification details
  title String
  message String
  type String
  
  // Relations
  senderId String
  sender User @relation("NotificationSender", fields: [senderId], references: [id])
  recipientId String
  recipient User @relation("NotificationRecipient", fields: [recipientId], references: [id])
  caseId String?
  case Arbitration? @relation(fields: [caseId], references: [id])
  
  // Status tracking
  isRead Boolean @default(false)
  readAt DateTime?
  
  // Additional data
  metadata Json?
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Model for hearing scheduling
model Hearing {
  id String @id @default(uuid())
  
  // Relations
  caseId String
  case Arbitration @relation(fields: [caseId], references: [id])
  arbitratorId String
  arbitrator User @relation("HearingArbitrator", fields: [arbitratorId], references: [id])
  
  // Hearing details
  type String @default("VIRTUAL") // VIRTUAL, IN_PERSON, HYBRID
  scheduledDate DateTime
  duration Int? // Duration in minutes
  location String? // Physical location or meeting link
  description String?
  
  // Status
  status String @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED, POSTPONED
  
  // Meeting details
  meetingLink String?
  meetingPassword String?
  dialInNumber String?
  
  // Notes and outcomes
  notes String?
  outcome String?
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}